# Live-run settings. Copy this file to .env, run chmod 600 .env, never commit .env.
# Each live switch unlocks only its own names; other entries are skipped with a warning.

# Read only with --model openrouter or --model openrouter:<id>.
OPENROUTER_API_KEY=
# Model id (vendor/model-name) for a bare --model openrouter; empty means the default in
# config/defaults.toml.
TAP_OPENROUTER_MODEL=

# Read only with --online. Both optional.
# Fine-grained GitHub token without repository access (public data only); raises the advisory API
# rate limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=
# NVD API key; raises the NVD rate limit from 5 to 50 requests per 30 seconds.
NVD_API_KEY=
